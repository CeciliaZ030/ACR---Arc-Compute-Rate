# Widget 3.1.4's unused optional Para/Privy peers conflict under npm resolution.
# This embed uses the built-in browser wallet, not either embedded provider.
#
# WHAT THIS SUPPRESSES, measured 2026-10-15 by installing without it: npm then
# wants a different tree (it pulls react-native 0.87 and @solana/kit 7 in as
# peers of the wallet SDKs) and flags valtio 1.13's use-sync-external-store 1.2,
# whose peer range stops at React 18 while this app runs React 19. It applies to
# EVERY install here (CI's `npm ci`, Vercel's `npm install`), so a peer problem
# in any other dependency is silenced too: when adding or upgrading packages,
# run `npm ls` and read the peer warnings yourself. Remove this file if the
# widget is ever removed; `@x402/core` then needs checking, since it is held in
# the tree by `@aomi-labs/client` as well as by the Gateway SDK.
legacy-peer-deps=true
