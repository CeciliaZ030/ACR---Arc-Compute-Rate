  {
   "id": "t-0198",
   "type": "text",
   "x": 73,
   "y": 1200,
   "width": 1896,
   "height": 18.8,
   "strokeColor": "#2f9e44",
   "fontSize": 15,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "text": "WHAT THE BRIEF MEASURES — and where it stands",
   "originalText": "WHAT THE BRIEF MEASURES — and where it stands",
   "autoResize": false,
   "angle": 0,
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "boundElements": null,
   "link": null,
   "locked": false,
   "isDeleted": false,
   "fillStyle": "solid",
   "backgroundColor": "transparent",
   "seed": 101393,
   "version": 1,
   "versionNonce": 202587,
   "updated": 1731542400000
  },
  {
   "id": "t-0200",
   "type": "text",
   "x": 73,
   "y": 1224.5,
   "width": 1896,
   "height": 32.5,
   "strokeColor": "#1e1e1e",
   "fontSize": 13,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "text": "businesses operated: 1 real, 1 labelled demonstration     ·     USDC received and paid out: never netted, never summed across chains     ·     paid out = 0\nobligations settled on time without a human touching them: 0     ·     decisions made vs escalated, and how often the human agreed: no approval has ever run",
   "originalText": "businesses operated: 1 real, 1 labelled demonstration     ·     USDC received and paid out: never netted, never summed across chains     ·     paid out = 0\nobligations settled on time without a human touching them: 0     ·     decisions made vs escalated, and how often the human agreed: no approval has ever run",
   "autoResize": false,
   "angle": 0,
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "boundElements": null,
   "link": null,
   "locked": false,
   "isDeleted": false,
   "fillStyle": "solid",
   "backgroundColor": "transparent",
   "seed": 101407,
   "version": 1,
   "versionNonce": 202613,
   "updated": 1731542400000
  },
  {
   "id": "t-0202",
   "type": "text",
   "x": 60,
   "y": 1326,
   "width": 1900,
   "height": 16.2,
   "strokeColor": "#1e1e1e",
   "fontSize": 13,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "text": "LIVE TODAY  ·  the eight refusals, the independent meter, the screen, PAR from the fleet and from anchors/, the ledger, the replayable record.",
   "originalText": "LIVE TODAY  ·  the eight refusals, the independent meter, the screen, PAR from the fleet and from anchors/, the ledger, the replayable record.",
   "autoResize": false,
   "angle": 0,
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "boundElements": null,
   "link": null,
   "locked": false,
   "isDeleted": false,
   "fillStyle": "solid",
   "backgroundColor": "transparent",
   "seed": 101421,
   "version": 1,
   "versionNonce": 202639,
   "updated": 1731542400000
  },
  {
   "id": "t-0204",
   "type": "text",
   "x": 60,
   "y": 1350,
   "width": 1900,
   "height": 16.2,
   "strokeColor": "#e03131",
   "fontSize": 13,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "text": "NOT YET  ·  PolicyWallet is deployed nowhere, so moved_usdc is 0 and no obligation has been settled without a human. Discovery is unbuilt. The loop runs on Arc testnet.",
   "originalText": "NOT YET  ·  PolicyWallet is deployed nowhere, so moved_usdc is 0 and no obligation has been settled without a human. Discovery is unbuilt. The loop runs on Arc testnet.",
   "autoResize": false,
   "angle": 0,
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "boundElements": null,
   "link": null,
   "locked": false,
   "isDeleted": false,
   "fillStyle": "solid",
   "backgroundColor": "transparent",
   "seed": 101435,
   "version": 1,
   "versionNonce": 202665,
   "updated": 1731542400000
  },
  {
   "id": "t-0206",
   "type": "text",
   "x": 60,
   "y": 1386,
   "width": 1900,
   "height": 18.8,
   "strokeColor": "#1e1e1e",
   "fontSize": 15,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "text": "The test of whether this is a pivot and not a rebrand: after it, the published index values can be deleted and the product loses nothing.",
